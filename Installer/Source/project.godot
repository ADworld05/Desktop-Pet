config_version=5
[application]
config/name="Desktop Pet Setup"
run/main_scene="res://Setup.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=720
window/size/viewport_height=760
window/size/window_width_override=720
window/size/window_height_override=760
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.93,0.96,0.99,1)
[debug]
file_logging/enable_file_logging=false
